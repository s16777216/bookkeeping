{
  "name": "receipt-graph-bookkeeper",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "generate-pwa-assets": "pwa-assets-generator && node -e \"const fs=require('fs'); fs.readdirSync('public').filter(f=>f.startsWith('apple-splash-landscape')||(f.startsWith('apple-splash-portrait')&&!f.includes('-light-'))).forEach(f=>fs.unlinkSync('public/'+f))\""
  },
  "dependencies": {
    "dexie": "^4.0.11",
    "sharp": "^0.35.4",
    "ulid": "^2.3.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vite-pwa/assets-generator": "^0.2.6",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.6.3",
    "vite": "^6.0.3",
    "vite-plugin-pwa": "^0.21.1",
    "vue-tsc": "^2.1.10"
  }
}
